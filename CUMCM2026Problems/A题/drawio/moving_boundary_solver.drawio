<mxfile host="app.diagrams.net"><diagram name="moving_boundary_solver"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="初值 T = 28 ℃、C = 2.55 kg/kg；初始化表面加密材料网格" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="650" height="65" /></mxCell><mxCell id="3" value="读取当前环境与 R(t)；径向位置 r = R(t) ξ" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="130" width="650" height="65" /></mxCell><mxCell id="e1" edge="1" parent="1" source="2" target="3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="4" value="材料速度等于网格速度；相对对流项为零" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="230" width="650" height="65" /></mxCell><mxCell id="e2" edge="1" parent="1" source="3" target="4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="5" value="更新热物性与界面扩散率；Picard 迭代至容差" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="330" width="650" height="65" /></mxCell><mxCell id="e3" edge="1" parent="1" source="4" target="5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="6" value="离散质量平衡核验；检查所有节点的最大含水率" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="430" width="650" height="65" /></mxCell><mxCell id="e4" edge="1" parent="1" source="5" target="6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="7" value="未达标则进入下一步；首次跨阈值则插值估计时间和剖面" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="530" width="650" height="65" /></mxCell><mxCell id="e5" edge="1" parent="1" source="6" target="7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="8" value="输出固定物理位置与动态表面；域外留空；记录核验数据" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="630" width="650" height="65" /></mxCell><mxCell id="e6" edge="1" parent="1" source="7" target="8"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>